{
  "name": "pqc-scan",
  "version": "0.1.2",
  "description": "Conservative post-quantum cryptography inventory for JavaScript, TypeScript, C, C++, Rust, Go and Python",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Giddywiddit/pqc-scan.git"
  },
  "homepage": "https://github.com/Giddywiddit/pqc-scan#readme",
  "bugs": {
    "url": "https://github.com/Giddywiddit/pqc-scan/issues"
  },
  "keywords": [
    "post-quantum",
    "cryptography",
    "pqc",
    "cbom",
    "cyclonedx",
    "sarif",
    "security",
    "static-analysis"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pqc-scan": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules",
    "schema",
    "grammars",
    "NOTICE"
  ],
  "scripts": {
    "scan": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p test/tsconfig.json",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/copy-grammars.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "tree-sitter-python": "0.25.0",
    "typescript": "5.9.3",
    "web-tree-sitter": "0.27.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tsx": "^4.20.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "tree-sitter-cpp": {
      "tree-sitter-c": "$tree-sitter-c"
    }
  }
}
