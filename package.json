{
  "name": "pqc-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conservative post-quantum cryptography inventory for JavaScript, TypeScript, C and C++",
  "scripts": {
    "scan": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tree-sitter-c": "0.24.1",
    "tree-sitter-cpp": "0.23.4",
    "web-tree-sitter": "0.27.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  },
  "license": "Apache-2.0",
  "overrides": {
    "tree-sitter-cpp": {
      "tree-sitter-c": "$tree-sitter-c"
    }
  }
}
